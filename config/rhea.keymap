#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
                &kp Q             &kp W  &kp E  &kp R  &kp T  &kp Y                   &kp U  &kp I  &kp O      &kp P          &kp BACKSLASH  &kp BSPC
                &kp TAB           &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J    &kp K  &kp L  &kp SEMI  &kp SINGLE_QUOTE  &kp RETURN     &trans
                &kp LEFT_SHIFT    &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT  &trans  &trans
                &kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &kp SPACE  &kp SPACE  &kp SPACE  &kp LEFT_ALT  &kp LEFT_GUI                          &kp SPACE  &kp SPACE
            >;
        };
    };
};
