#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
                &kp TAB             &kp Q       &kp W          &kp E        &kp R        &kp T                       &kp Y        &kp U        &kp I       &kp P       &kp O         &kp RIGHT_BRACKET
                &kp LEFT_CONTROL    &kp A       &kp S          &kp D        &kp F        &kp G                       &kp H        &kp J        &kp K       &kp L       &kp SEMI      &kp SINGLE_QUOTE
                &kp LEFT_SHIFT      &kp Z       &kp X            &kp C        &kp V        &kp B                       &kp N        &kp M        &kp COMMA   &kp DOT     &kp FSLH      &kp RIGHT_SHIFT
                &kp LEFT_CONTROL  &kp LEFT_GUI &kp LEFT_ALT   &kp SPACE    &kp SPACE    &kp SPACE                  &kp SPACE    &kp SPACE                            &kp LEFT_ALT  &kp LEFT_GUI
            >;
        };
    };
};
